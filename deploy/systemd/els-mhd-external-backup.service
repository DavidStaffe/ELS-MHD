[Unit]
Description=ELS-MHD encrypted backup to external USB drive
After=local-fs.target
OnFailure=els-mhd-backup-failure@%n.service
# Intentional: no RequiresMountsFor; script rejects absent or incorrect UUID.

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/els-mhd-external-backup
TimeoutStartSec=45min
NoNewPrivileges=true
